<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact — Blended</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1E2328; --ink-soft:#4A5158; --paper:#F6F3EE; --paper-raised:#FFFFFF;
    --rose:#C9776B; --teal:#2C6E6B; --gold:#C9A227; --line:rgba(30,35,40,0.12);
    --blend: linear-gradient(90deg, var(--rose) 0%, var(--gold) 50%, var(--teal) 100%);
  }
  *{ box-sizing:border-box; }
  body{ margin:0; background:var(--paper); color:var(--ink); font-family:'Inter', sans-serif; line-height:1.65; -webkit-font-smoothing:antialiased; }
  a{ color:var(--teal); }
  .wrap{ max-width:760px; margin:0 auto; padding:0 32px; }
  nav.navwrap{ max-width:1080px; margin:0 auto; padding:28px 32px; display:flex; align-items:center; justify-content:space-between; }
  .nav-mark{ font-family:'Fraunces', serif; font-size:22px; font-weight:600; letter-spacing:-0.01em; text-decoration:none; color:var(--ink); }
  .nav-links{ display:flex; gap:32px; font-size:14px; color:var(--ink-soft); }
  .nav-links a{ text-decoration:none; color:var(--ink-soft); }
  .nav-links a:hover{ color:var(--ink); }
  .blend-bar{ height:6px; width:100%; background:var(--blend); background-size:300% 100%; }
  header.page-head{ padding:64px 0 40px; }
  .eyebrow{ font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.12em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:16px; }
  h1{ font-family:'Fraunces', serif; font-weight:600; font-size:clamp(36px,6vw,52px); margin:0 0 12px; letter-spacing:-0.01em; }
  .hero-sub{ color:var(--ink-soft); font-size:17px; max-width:480px; margin:0; }
  main{ padding-bottom:96px; }

  .contact-grid{ display:grid; grid-template-columns:1fr 1fr; gap:56px; margin-top:48px; }

  .info-card{ background:var(--paper-raised); border:1px solid var(--line); padding:28px; margin-bottom:20px; }
  .info-card .label{ font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.08em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:10px; display:block; }
  .info-card .value{ font-family:'Fraunces', serif; font-size:20px; font-weight:600; }
  .info-card .value a{ text-decoration:none; color:var(--ink); }
  .info-card .value a:hover{ color:var(--teal); }

  form{ display:flex; flex-direction:column; gap:16px; }
  label{ font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.06em; text-transform:uppercase; color:var(--ink-soft); }
  input, textarea{
    font-family:'Inter', sans-serif; font-size:15px; color:var(--ink);
    background:var(--paper-raised); border:1px solid var(--line);
    padding:12px 14px; width:100%; border-radius:2px;
  }
  input:focus, textarea:focus{ outline:2px solid var(--teal); outline-offset:1px; }
  textarea{ resize:vertical; min-height:120px; }
  .btn{
    display:inline-flex; align-items:center; gap:8px; align-self:flex-start;
    font-family:'Inter', sans-serif; font-size:14px; font-weight:600;
    padding:14px 24px; border-radius:2px; text-decoration:none;
    border:1px solid var(--ink); background:var(--ink); color:var(--paper);
    cursor:pointer; transition:transform 0.15s ease;
  }
  .btn:hover{ transform:translateY(-2px); }
  .form-note{ font-size:13px; color:var(--ink-soft); margin-top:4px; }

  footer{ max-width:1080px; margin:0 auto; padding:40px 32px 64px; }
  .footer-links{ display:flex; gap:24px; font-size:13px; color:var(--ink-soft); flex-wrap:wrap; }
  .footer-links a{ text-decoration:none; color:var(--ink-soft); }
  .footer-links a:hover{ color:var(--ink); }
  .footer-copy{ font-size:13px; color:var(--ink-soft); margin-top:20px; }

  @media (max-width:700px){
    .contact-grid{ grid-template-columns:1fr; }
    nav.navwrap{ flex-direction:column; gap:16px; align-items:flex-start; }
  }
</style>
</head>
<body>

<nav class="navwrap">
  <a class="nav-mark" href="index.html">Blended</a>
  <div class="nav-links">
    <a href="index.html#categories">Categories</a>
    <a href="index.html#about">About</a>
    <a href="contact.html">Contact</a>
  </div>
</nav>
<div class="blend-bar"></div>

<header class="page-head wrap">
  <div class="eyebrow">Get in touch</div>
  <h1>Contact</h1>
  <p class="hero-sub">Questions about a product, a collaboration idea, or just want to say hi — reach out below.</p>
</header>

<main class="wrap">
  <div class="contact-grid">
    <div>
      <div class="info-card">
        <span class="label">Email</span>
        <span class="value"><a href="mailto:hello@blended.com">hello@blended.com</a></span>
      </div>
      <div class="info-card">
        <span class="label">Pinterest</span>
        <span class="value"><a href="https://pinterest.com/" target="_blank" rel="noopener">@blended</a></span>
      </div>
    </div>

    <div>
      <form action="mailto:hello@blended.com" method="post" enctype="text/plain">
        <div>
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div>
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required>
        </div>
        <div>
          <label for="message">Message</label>
          <textarea id="message" name="message" required></textarea>
        </div>
        <button type="submit" class="btn">Send message</button>
        <p class="form-note">This opens your email app to send the message directly to hello@blended.com.</p>
      </form>
    </div>
  </div>
</main>

<div class="blend-bar"></div>
<footer>
  <div class="footer-links">
    <a href="https://pinterest.com/" target="_blank" rel="noopener">Pinterest</a>
    <a href="contact.html">Contact</a>
    <a href="privacy.html">Privacy Policy</a>
    <a href="terms.html">Terms of Use</a>
  </div>
  <div class="footer-copy">© 2026 Blended. As an Amazon Associate, Blended earns from qualifying purchases.</div>
</footer>

</body>
</html>
